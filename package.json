{
  "name": "hiit-master-rebuild",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "tsc -b && vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit",
    "cap:copy": "bun run build && cap copy",
    "cap:sync": "bun run build && cap sync",
    "cap:open:ios": "cap open ios",
    "cap:run:ios": "bun run build && cap run ios",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "build:spec": "dts-bundle-generator -o dist/spec.d.ts app/src/domain"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.1.3",
    "@capacitor-community/keep-awake": "^8.0.0",
    "@capacitor/core": "^8.3.0",
    "@capacitor/ios": "^8.3.0",
    "@preact/signals": "^2.2.1",
    "@rollup/rollup-darwin-arm64": "^4.60.1",
    "@types/bun": "^1.3.14",
    "preact": "^10.26.4",
    "preact-iso": "^2.9.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.0",
    "@chromatic-com/storybook": "^5.2.1",
    "@preact/preset-vite": "^2.10.2",
    "@storybook/addon-a11y": "^10.4.1",
    "@storybook/addon-docs": "^10.4.1",
    "@storybook/addon-mcp": "^0.6.0",
    "@storybook/addon-vitest": "^10.4.1",
    "@storybook/preact-vite": "^10.4.1",
    "@testing-library/preact": "^3.2.4",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.5.2",
    "@vitest/browser": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "dts-bundle-generator": "^9.5.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^27.0.0",
    "playwright": "^1.60.0",
    "postcss": "^8.5.6",
    "storybook": "^10.4.1",
    "tailwindcss": "^3.4.17",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.11.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  },
  "trustedDependencies": [
    "ws"
  ]
}
